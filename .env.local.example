# Copy to .env.local and fill in from:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project kitchen-replacement
#
# The NEXT_PUBLIC_* values are shipped to the browser by design — they identify
# the project, they don't authorise anything. Access is controlled by the
# security rules in firestore.rules / storage.rules, never by hiding these.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kitchen-replacement.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kitchen-replacement
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kitchen-replacement.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side only. Never prefixed NEXT_PUBLIC_ — this key bypasses all
# security rules. Generate at:
#   Firebase console > Project settings > Service accounts > Generate new key
# Then base64 the whole JSON file so it survives being a single env var:
#   base64 -i service-account.json | pbcopy
#
# Leave empty when running somewhere with Application Default Credentials
# (Cloud Run, App Hosting, or after `gcloud auth application-default login`) —
# admin.ts falls back to ADC automatically.
FIREBASE_SERVICE_ACCOUNT_B64=
